{
  "family": "rrhh-gateway",
  "requiresCompatibilities": ["EC2"],
  "networkMode": "host",
  "containerDefinitions": [
    {
      "name": "rrhh-gateway",
      "image": "ACCOUNT_ID.dkr.ecr.us-east-1.amazonaws.com/rrhh:gateway",
      "memory": 256,
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "hostPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "cognito" },
        { "name": "SERVER_PORT", "value": "8080" },
        { "name": "COGNITO_ISSUER", "value": "https://cognito-idp.us-east-1.amazonaws.com/us-east-1_REPLACE" },
        { "name": "CORS_ALLOWED_ORIGINS", "value": "http://PUBLIC_HOST:3000" },
        { "name": "RRHH_IDENTITY_URL", "value": "http://127.0.0.1:8081" },
        { "name": "RRHH_TRABAJADORES_URL", "value": "http://127.0.0.1:8082" },
        { "name": "RRHH_CONTRATOS_URL", "value": "http://127.0.0.1:8083" },
        { "name": "RRHH_ASISTENCIA_URL", "value": "http://127.0.0.1:8084" },
        { "name": "RRHH_AUSENCIAS_URL", "value": "http://127.0.0.1:8085" },
        { "name": "RRHH_NOTIFICATIONS_URL", "value": "http://127.0.0.1:8086" },
        { "name": "SPRING_DATA_REDIS_HOST", "value": "127.0.0.1" },
        { "name": "SPRING_DATA_REDIS_PORT", "value": "6379" },
        { "name": "RRHH_RATE_LIMIT_REPLENISH", "value": "30" },
        { "name": "RRHH_RATE_LIMIT_BURST", "value": "60" },
        { "name": "RRHH_RATE_LIMIT_BACKEND", "value": "auto" }
      ]
    }
  ]
}
