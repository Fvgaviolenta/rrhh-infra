# Copiar a .env.aws (chmod 600). NO commitear valores reales.

AWS_REGION=us-east-1
AWS_ACCOUNT_ID=111111111111
ECR_REGISTRY=111111111111.dkr.ecr.us-east-1.amazonaws.com
# Un solo repo ECR; cada MS es un tag (identity, trabajadores, …). No hay tag frontend.
ECR_REPOSITORY=rrhh

# VPC por defecto (EC2 → VPC → Your VPCs / Subnets)
VPC_ID=vpc-xxxxxxxx
VPC_CIDR=172.31.0.0/16
SUBNET_1=subnet-aaaaaaaa
SUBNET_2=subnet-bbbbbbbb

# Security groups (salida de rrhh-infra/ecs/create-security-groups.sh)
SG_ALB_INTERNAL=sg-xxxxxxxx
SG_FARGATE_MS=sg-xxxxxxxx
SG_DATOS=sg-xxxxxxxx

# IP privada de la EC2 de datos (MySQL/Redis, RabbitMQ). JDBC de Fargate.
DATA_HOST=172.31.x.x

# DNS que emite AWS al crear el ALB interno (no inventar)
INTERNAL_ALB_DNS=internal-rrhh-alb-internal-522441928.us-east-1.elb.amazonaws.com
HTTP_API_URL=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com

# SPA en Amplify (zip). No hay ALB público.
PUBLIC_FRONTEND_URL=https://staging.ddz08ku6sazjt.amplifyapp.com
VITE_API_GATEWAY_URL=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com

# Cognito
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_xxxxxxxxx
COGNITO_AUDIENCE=
COGNITO_REGION=us-east-1

# Datos en la EC2 (Compose)
MYSQL_ROOT_PASSWORD=rrhh_root
MYSQL_DATABASE=rrhh_db
MYSQL_USER=rrhh
MYSQL_PASSWORD=rrhh_local
SPRING_DATASOURCE_USERNAME=rrhh
SPRING_DATASOURCE_PASSWORD=rrhh_local
SPRING_PROFILES_ACTIVE=cognito
RABBITMQ_USER=rrhh
RABBITMQ_PASSWORD=rrhh_local
CORS_ALLOWED_ORIGINS=https://staging.ddz08ku6sazjt.amplifyapp.com,http://localhost:5173

